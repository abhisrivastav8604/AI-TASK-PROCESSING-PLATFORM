# ── MongoDB ──────────────────────────────────────────────────────────────────
# Must match the backend MONGO_URI exactly so both services hit the same DB.
# Local:   mongodb://localhost:27017/ai_tasks
# Docker:  mongodb://mongodb:27017/ai_tasks
MONGO_URI=mongodb://mongodb:27017/ai_tasks

# ── Redis ─────────────────────────────────────────────────────────────────────
# Must match the backend REDIS_URL.
# Local:  redis://localhost:6379
# Docker: redis://redis:6379
REDIS_URL=redis://redis:6379

# ── Logging ───────────────────────────────────────────────────────────────────
# Set to "production" to get JSON-formatted logs.
NODE_ENV=development
LOG_LEVEL=INFO
