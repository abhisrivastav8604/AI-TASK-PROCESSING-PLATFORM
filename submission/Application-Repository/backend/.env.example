# ── Server ────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── MongoDB ───────────────────────────────────────────────────
# Local:      mongodb://localhost:27017/ai_tasks
# Atlas:      mongodb+srv://<user>:<pass>@cluster.mongodb.net/ai_tasks
MONGO_URI=mongodb://localhost:27017/ai_tasks

# ── JWT ───────────────────────────────────────────────────────
# Use a long, random secret (min 32 chars): openssl rand -hex 32
JWT_SECRET=change_me_use_openssl_rand_hex_32
JWT_EXPIRES_IN=7d

# ── Redis ─────────────────────────────────────────────────────
# Local:  redis://localhost:6379
# TLS:    rediss://:<password>@<host>:6380
REDIS_URL=redis://localhost:6379

# ── CORS ──────────────────────────────────────────────────────
# Comma-separated allowed origins. Use * only in development.
CORS_ORIGIN=http://localhost:3000

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=info
